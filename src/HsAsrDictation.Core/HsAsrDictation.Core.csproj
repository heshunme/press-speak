    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HsAsrDictation</RootNamespace>
    <AssemblyName>HsAsrDictation.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.12.34" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HsAsrDictation" />
    <InternalsVisibleTo Include="HsAsrDictation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\PostProcessing\default-rules.json" />
  </ItemGroup>
</Project>
